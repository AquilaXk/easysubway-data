{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easysubway.local/schema/datapack-release-evidence-bundle.schema.json",
  "title": "EasySubway data pack release evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "candidateId",
    "buildCandidateId",
    "candidateBuilderGitSha",
    "scopeId",
    "verifiedAccessibilityScopeId",
    "verifiedAccessibilityScopeSha256",
    "launchScopeId",
    "launchScopeSha256",
    "nationwideRoadmapScopeId",
    "nationwideRoadmapScopeSha256",
    "identityLinkageMatrixSha256",
    "launchDenominatorDecision",
    "launchDenominatorReportSha256",
    "releaseRequestId",
    "builderGitSha",
    "buildSpecSha256",
    "supportedDenominatorSha256",
    "sourceSnapshotSetHash",
    "approvedAliasLedgerHash",
    "facilityEvidenceLedgerHash",
    "routeEvidenceLedgerHash",
    "approvedOverrideSetHash",
    "normalizedSourceInventorySha256",
    "sqliteSha256",
    "gzipSha256",
    "manifestSha256",
    "coverageSummarySha256",
    "accessibilitySourceCoverageSha256",
    "accessibilitySourceCoverageDecision",
    "itxCheongchunCoverageSha256",
    "routeMapPositionCoverageSha256",
    "routeGraphTopologySha256",
    "headwayReportSha256",
    "strictRouteRegressionSha256",
    "androidEvidenceSha256",
    "routeGraphTopologyViolationCount",
    "validatorStatus",
    "coverageStatus",
    "routeMapPositionCoverageStatus",
    "routeGraphTopologyStatus",
    "headwayReportStatus",
    "strictRouteRegressionStatus",
    "manifestSignatureStatus",
    "androidEvidenceStatus",
    "createdAt",
    "workflowRunUrl"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "datapack-release-evidence-bundle" },
    "candidateId": { "type": "string", "minLength": 1 },
    "buildCandidateId": { "type": "string", "minLength": 1 },
    "candidateBuilderGitSha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
    "scopeId": { "type": "string", "minLength": 1 },
    "verifiedAccessibilityScopeId": { "type": "string", "minLength": 1 },
    "verifiedAccessibilityScopeSha256": { "$ref": "#/$defs/sha256" },
    "launchScopeId": { "type": "string", "minLength": 1 },
    "launchScopeSha256": { "$ref": "#/$defs/sha256" },
    "nationwideRoadmapScopeId": { "type": "string", "minLength": 1 },
    "nationwideRoadmapScopeSha256": { "$ref": "#/$defs/sha256" },
    "identityLinkageMatrixSha256": { "$ref": "#/$defs/sha256" },
    "launchDenominatorDecision": { "enum": ["GO", "NO_GO"] },
    "launchDenominatorReportSha256": { "$ref": "#/$defs/sha256" },
    "releaseRequestId": { "type": "string", "minLength": 1 },
    "builderGitSha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
    "buildSpecSha256": { "$ref": "#/$defs/sha256" },
    "supportedDenominatorSha256": { "$ref": "#/$defs/sha256" },
    "sourceSnapshotSetHash": { "$ref": "#/$defs/sha256" },
    "approvedAliasLedgerHash": { "$ref": "#/$defs/sha256" },
    "facilityEvidenceLedgerHash": { "$ref": "#/$defs/sha256" },
    "routeEvidenceLedgerHash": { "$ref": "#/$defs/sha256" },
    "approvedOverrideSetHash": { "$ref": "#/$defs/sha256" },
    "normalizedSourceInventorySha256": { "$ref": "#/$defs/sha256" },
    "sqliteSha256": { "$ref": "#/$defs/sha256" },
    "gzipSha256": { "$ref": "#/$defs/sha256" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "coverageSummarySha256": { "$ref": "#/$defs/sha256" },
    "accessibilitySourceCoverageSha256": { "$ref": "#/$defs/sha256" },
    "accessibilitySourceCoverageDecision": { "enum": ["GO", "NO_GO", "NOT_EVALUATED"] },
    "itxCheongchunCoverageSha256": { "$ref": "#/$defs/sha256" },
    "routeMapPositionCoverageSha256": { "$ref": "#/$defs/sha256" },
    "routeGraphTopologySha256": { "$ref": "#/$defs/sha256" },
    "headwayReportSha256": { "$ref": "#/$defs/sha256" },
    "strictRouteRegressionSha256": { "$ref": "#/$defs/sha256" },
    "androidEvidenceSha256": { "$ref": "#/$defs/sha256" },
    "validatorStatus": { "$ref": "#/$defs/gateStatus" },
    "coverageStatus": { "$ref": "#/$defs/gateStatus" },
    "routeMapPositionCoverageStatus": { "$ref": "#/$defs/gateStatus" },
    "routeGraphTopologyStatus": { "$ref": "#/$defs/routeGraphGateStatus" },
    "routeGraphTopologyViolationCount": { "type": "integer", "minimum": 0 },
    "headwayReportStatus": { "$ref": "#/$defs/headwayGateStatus" },
    "strictRouteRegressionStatus": { "$ref": "#/$defs/gateStatus" },
    "manifestSignatureStatus": { "$ref": "#/$defs/gateStatus" },
    "androidEvidenceStatus": { "$ref": "#/$defs/gateStatus" },
    "rollbackRescue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceSha256",
        "releaseRequestId",
        "rollbackApprovalEventId",
        "rcCandidateId",
        "rcManifestSha256",
        "currentReleaseSequence",
        "failedReleaseSequence",
        "knownGoodReleaseSequence",
        "rescueReleaseSequence",
        "knownGoodPackSha256",
        "knownGoodSqliteSha256",
        "rescueManifestSha256",
        "recoveryDurationSeconds",
        "validatorStatus",
        "manifestLastStatus",
        "executionEnvironment",
        "productionExecuted"
      ],
      "properties": {
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "releaseRequestId": { "type": "string", "minLength": 1 },
        "rollbackApprovalEventId": { "type": "string", "minLength": 1 },
        "rcCandidateId": { "type": "string", "minLength": 1 },
        "rcManifestSha256": { "$ref": "#/$defs/sha256" },
        "currentReleaseSequence": { "type": "integer", "minimum": 1 },
        "failedReleaseSequence": { "type": "integer", "minimum": 1 },
        "knownGoodReleaseSequence": { "type": "integer", "minimum": 1 },
        "rescueReleaseSequence": { "type": "integer", "minimum": 1 },
        "knownGoodPackSha256": { "$ref": "#/$defs/sha256" },
        "knownGoodSqliteSha256": { "$ref": "#/$defs/sha256" },
        "rescueManifestSha256": { "$ref": "#/$defs/sha256" },
        "recoveryDurationSeconds": { "type": "integer", "minimum": 0 },
        "validatorStatus": { "enum": ["PASS", "FAIL"] },
        "manifestLastStatus": { "enum": ["PASS", "FAIL", "NOT_EXECUTED"] },
        "executionEnvironment": { "enum": ["DRY_RUN", "LOCAL_FIXTURE", "NON_PRODUCTION", "PRODUCTION"] },
        "productionExecuted": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "workflowRunUrl": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gateStatus": {
      "enum": ["PASS", "FAIL", "BLOCKED_EXTERNAL"]
    },
    "headwayGateStatus": {
      "enum": ["PASS", "FAIL", "BLOCKED_EXTERNAL", "DEFERRED"]
    },
    "routeGraphGateStatus": {
      "enum": ["PASS", "FAIL", "BLOCKED_EXTERNAL", "DEFERRED"]
    }
  }
}
