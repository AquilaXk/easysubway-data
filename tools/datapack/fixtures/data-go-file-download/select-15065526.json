 서비스 개선 검토를 위한 기초자료로 활용할 수 있습니다. 또한 요일별 운행 정보를 제공하여 이용 패턴에 따른 대중교통 이용 계획 수립과 효율적인 이동 경로 검토에 활용할 수 있습니다. 본 데이터는 운행 시각표 변경 등 변동 사항 발생 시 갱신되며, 변경된 열차 운행 계획을 반영합니다.<br/>","kwrd":"대구도시철도,지하철,1호선,열차시각표,상선,열차번호,요일별운행정보,Social","brmCode":"NB000220061213100114111","brmUpperCode":null,"dataHoldBasis":"","provdTrgetSe":"PROV01","provdReqstRegistAt":"N","provdReqstSn":null,"mgahaDataYn":"N","coreDataAt":"N","registTy":"RETY02","colctMth":"","dataLimit":"","publicDataTyCode":"PR0051","publicDataTyDetailCode":"DATY03","insttCode":"B554805","jrsdMiryfcCode":"B552109","pchrgAt":"N","dataCpyrhtensureAt":"N","usePrmisnEnnc":"N","useScopeCode":"COEX07","useScopeResn":"","rsrchPblictnAt":"N","rsrchPblictnUseScopeCode":null,"ctLevyUnitCode":"COUN01","ctLevyUnitNm":"","infoPrcuseAmount":0,"nextRegistPrarnde":null,"dataRegistCycle":"RECY07","dataRegistCycleNm":null,"aiTypeYn":"N","registerId":null,"registDt":"2023-05-10 14:32:07.000","updusrId":null,"updtDt":"2026-07-07 11:09:31.000","inqireCo":8569,"deleteAt":"N","deleteResnCode":null,"registerNm":null,"updusrNm":null,"kwrdEn":"Daegu Metro,subway,Line 1,Train timetable,merchant ship,Train number,Operation Information by Day of the Week,Social","dataHoldBasisEn":"","searchCondition4":"","searchCondition5":"","searchCondition6":"","searchCondition7":"","startDt":null,"endDt":null,"startDt2":null,"endDt2":null,"seExclDeletion":null,"publicDataTyCodeNm":null,"publicDataTyDetailCodeNm":null,"useScopeCodeNm":null,"rsrchPblictnUseScopeCodeNm":null,"jrsdMiryfcCodeNm":null,"insttCodeNm":null,"processSttusCodeNm":null,"processResultCodeNm":null,"brmCdNm":null,"brmCodeNm":"교통및물류 - 철도","brmUpperCodeNm":null,"insttNm":"대구교통공사","processSttusTyCodeNm":null,"processTyResultCodeNm":null,"ctLevyUnitCodeNm":null,"mberAuthorNm":null,"reprsntchargerNm":null,"reprsntchargerPsitnDept":null,"encReprsntchargerTelno":null,"telNo":null,"reprsntchargerEmail":null,"atchFileId":null,"seqNo":"4","atchFileTyCode":"DATD01","fileDetailSn":"1","cnt":0,"gubn":null,"dlbrtCo