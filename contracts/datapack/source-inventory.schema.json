{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easysubway/contracts/datapack/source-inventory",
  "title": "데이터팩 source inventory",
  "type": "object",
  "required": ["schemaVersion", "region", "artifactKind", "retrievedAt", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "region": { "type": "string" },
    "artifactKind": { "type": "string", "const": "production-source-inventory" },
    "retrievedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "type": "object",
            "required": ["coverageScope", "rawSnapshotAdmission", "requiredForProductionPack", "productionUseAllowed", "capabilities"],
            "properties": {
              "coverageScope": {
                "type": "object",
                "required": ["mappingStatus", "regionIds", "operatorIds"],
                "properties": {
                  "mappingStatus": { "const": "UNMAPPED_RAW_SNAPSHOT" },
                  "regionIds": { "type": "array", "maxItems": 0 },
                  "operatorIds": { "type": "array", "maxItems": 0 }
                }
              },
              "requiredForProductionPack": { "const": false },
              "productionUseAllowed": { "const": false },
              "capabilities": {
                "type": "object",
                "required": ["schedule", "realtime", "facility"],
                "properties": {
                  "schedule": { "type": "object", "required": ["productionUseAllowed"], "properties": { "productionUseAllowed": { "const": false } } },
                  "realtime": { "type": "object", "required": ["productionUseAllowed"], "properties": { "productionUseAllowed": { "const": false } } },
                  "facility": { "type": "object", "required": ["productionUseAllowed"], "properties": { "productionUseAllowed": { "const": false } } }
                }
              }
            }
          },
          {
            "type": "object",
            "not": { "type": "object", "required": ["rawSnapshotAdmission"] },
            "properties": {
              "coverageScope": {
                "type": "object",
                "not": { "type": "object", "required": ["mappingStatus"] }
              }
            }
          }
        ],
        "required": [
          "id",
          "displayName",
          "owner",
          "provider",
          "providerDepartment",
          "sourceSystem",
          "datasetUrl",
          "datasetKind",
          "coverage",
          "coverageScope",
          "requiredForProductionPack",
          "updateFrequency",
          "observedDataUpdatedAt",
          "retrievedAt",
          "license",
          "fieldsProvided",
          "capabilities"
        ],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "owner": { "type": "string" },
          "provider": { "type": "string" },
          "providerDepartment": { "type": "string" },
          "sourceSystem": { "type": "string" },
          "datasetUrl": { "type": "string" },
          "datasetKind": { "type": "string" },
          "coverage": { "type": "string" },
          "coverageScope": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["regionIds", "operatorIds", "sourceDomains"],
                "properties": {
                  "regionIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "operatorIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "lineIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "sourceDomains": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mappingStatus", "regionIds", "operatorIds", "sourceDomains"],
                "properties": {
                  "mappingStatus": { "const": "UNMAPPED_RAW_SNAPSHOT" },
                  "regionIds": { "type": "array", "items": { "type": "string" } },
                  "operatorIds": { "type": "array", "items": { "type": "string" } },
                  "sourceDomains": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                }
              }
            ]
          },
          "requiredForProductionPack": { "type": "boolean" },
          "productionUseAllowed": { "type": "boolean" },
          "updateFrequency": { "type": "string" },
          "observedDataUpdatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "retrievedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "attribution",
              "commercialUseAllowed",
              "derivativeWorkAllowed",
              "redistributionAllowed",
              "evidenceUrl"
            ],
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" },
              "attribution": { "type": "string" },
              "commercialUseAllowed": { "type": "boolean" },
              "derivativeWorkAllowed": { "type": "boolean" },
              "redistributionAllowed": { "type": "boolean" },
              "evidenceUrl": { "type": "string" }
            }
          },
          "fieldsProvided": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "productDerivedFields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "정본 raw field와 분리해 제품의 결정론적 materializer가 산출하는 필드다."
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schedule", "realtime", "facility"],
            "properties": {
              "schedule": { "type": "object" },
              "realtime": { "type": "object" },
              "facility": { "type": "object" },
              "transfer": { "type": "object" }
            }
          },
          "registrationEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactKind",
              "sourceId",
              "snapshotId",
              "capturedAt",
              "snapshotFileSha256",
              "snapshotRawSha256",
              "rawObjectUri",
              "rawObjectSha256",
              "contentSha256",
              "normalizedSchemaFingerprint",
              "claimBindingsSha256",
              "capturedTopology",
              "rowCount",
              "coverageCount",
              "claimBindingCount",
              "adminReviewRecordHash",
              "registeredAt"
            ],
            "properties": {
              "artifactKind": { "const": "source-registration-evidence" },
              "sourceId": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "capturedAt": { "type": "string", "format": "date-time" },
              "snapshotFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "snapshotRawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "rawObjectUri": { "type": "string", "pattern": "^oci://" },
              "rawObjectSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "normalizedSchemaFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "claimBindingsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "capturedTopology": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceId", "snapshotId", "contentSha256", "claimTopologySha256"],
                "properties": {
                  "sourceId": { "const": "incheon-transit-station-info" },
                  "snapshotId": { "type": "string", "pattern": "^incheon-transit-station-info-[0-9]{8}$" },
                  "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "claimTopologySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              },
              "rowCount": { "type": "integer", "minimum": 1 },
              "coverageCount": { "type": "integer", "minimum": 1 },
              "claimBindingCount": { "type": "integer", "minimum": 1 },
              "adminReviewRecordHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "registeredAt": { "type": "string", "format": "date-time" }
            }
          },
          "admissionEvidence": {
            "type": "object",
            "description": "승격 단계별 sanitized evidence를 보존하는 승인 필드 envelope이며 licenseEvidenceHash만 공통 필수다.",
            "additionalProperties": false,
            "required": ["licenseEvidenceHash"],
            "properties": {
              "artifactKind": { "type": "string" },
              "issue": { "type": "integer" },
              "candidateId": { "type": "string" },
              "sourceId": { "type": "string" },
              "snapshotId": { "type": "string" },
              "decision": { "type": "string" },
              "approvedBy": { "type": "string" },
              "approvedAt": { "type": "string" },
              "sampleEvidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "schemaFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sourceSnapshotSetHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sourceInventorySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "adminReviewRecordHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "licenseEvidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "aliasLedgerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "operatorMappingLedgerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "facilityEvidenceLedgerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "routeEvidenceLedgerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "overrideHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "admissionDurationSeconds": { "type": "integer", "minimum": 0 },
              "quotaEvidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["defaultDailyLimit", "portal", "productionUseAllowed", "unlockStatus"],
                "properties": {
                  "portal": { "type": "string" },
                  "defaultDailyLimit": { "type": ["integer", "string", "null"] },
                  "unlockStatus": { "type": "string" },
                  "productionUseAllowed": { "type": "boolean" },
                  "documentedMonthlyLimit": { "type": "integer" },
                  "runtimeDailyHardLimit": { "type": "integer" },
                  "runtimePerMinuteHardLimit": { "type": "integer" },
                  "sharedQuotaStore": { "type": "string" }
                }
              },
              "productionUseNoteKo": { "type": "string" }
            }
          },
          "transferAdmissionEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactKind", "approvalIssue", "decision", "approvedBy", "approvedAt", "productionUseAllowed", "snapshotId", "snapshotPath", "snapshotFileSha256", "capturedAt", "observedAt", "freshUntil", "sourceEffectiveDate", "rawSha256", "contentSha256", "schemaFingerprint", "metricsPath", "metricsArtifactSha256", "applicabilityPath", "applicabilityArtifactSha256", "rowCount", "physicalPairCount", "directedMetricCount", "officialMetricCount", "derivedReciprocalMetricCount", "stationLineCount", "applicableStationLineCount", "notApplicableStationLineCount", "durationRole", "licenseEvidenceHash"],
            "properties": {
              "artifactKind": { "const": "transfer-source-admission-evidence" }, "approvalIssue": { "const": 350 }, "decision": { "const": "APPROVED" }, "approvedBy": { "const": "AquilaXk" }, "approvedAt": { "type": "string", "format": "date-time" }, "productionUseAllowed": { "const": true },
              "snapshotId": { "type": "string" }, "snapshotPath": { "type": "string", "pattern": "^tools/datapack/sources/seoul-metro-transfer-distance-duration-[0-9TZ]+\\.json$" }, "snapshotFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "capturedAt": { "type": "string", "format": "date-time" }, "observedAt": { "type": "string", "format": "date-time" }, "freshUntil": { "type": "string", "format": "date-time" }, "sourceEffectiveDate": { "const": "2025-12-31" },
              "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "schemaFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "metricsPath": { "const": "tools/datapack/release/current-transfer-topology-metrics.json" }, "metricsArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "applicabilityPath": { "const": "tools/datapack/release/current-capital-transfer-topology-applicability.json" }, "applicabilityArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "rowCount": { "const": 145 }, "physicalPairCount": { "const": 15 }, "directedMetricCount": { "const": 30 }, "officialMetricCount": { "const": 28 }, "derivedReciprocalMetricCount": { "const": 2 }, "stationLineCount": { "const": 213 }, "applicableStationLineCount": { "const": 27 }, "notApplicableStationLineCount": { "const": 186 }, "durationRole": { "const": "REFERENCE_ONLY" }, "licenseEvidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "membershipAdmissionEvidence": {
            "type": "object",
            "description": "역·노선 정본과 운영기관 역번호를 field-level provenance로 결속한 production 승인 근거다.",
            "additionalProperties": false,
            "required": [
              "issue",
              "materializer",
              "verificationTest",
              "snapshotId",
              "lineIds",
              "verifiedAt",
              "stationCount",
              "membershipSourceId",
              "membershipSourceRawSha256",
              "membershipSourceSnapshotSha256",
              "mappingSha256",
              "stationCodesSha256",
              "stationCodeSourceId",
              "stationCodeSnapshotId",
              "stationCodeContentSha256"
            ],
            "properties": {
              "issue": { "type": "integer", "minimum": 1 },
              "materializer": { "type": "string", "minLength": 1 },
              "verificationTest": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "lineIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "verifiedAt": { "type": "string", "format": "date-time" },
              "stationCount": { "type": "integer", "minimum": 1 },
              "membershipSourceId": { "type": "string", "minLength": 1 },
              "membershipSourceRawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "membershipSourceSnapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "mappingSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "stationCodesSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "stationCodeSourceId": { "type": "string", "minLength": 1 },
              "stationCodeSnapshotId": { "type": "string", "minLength": 1 },
              "stationCodeContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "topologyAdmissionEvidence": {
            "type": "object",
            "description": "공식 topology snapshot의 production materialization 승인 근거다.",
            "additionalProperties": false,
            "required": [
              "issue",
              "materializer",
              "verificationTest",
              "snapshotId",
              "snapshotPath",
              "capturedAt",
              "freshUntil",
              "stationCount",
              "edgeCount",
              "excludedTransferCount",
              "rawSha256",
              "contentSha256"
            ],
            "properties": {
              "issue": { "type": "integer", "minimum": 1 },
              "materializer": { "type": "string", "minLength": 1 },
              "verificationTest": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "snapshotPath": { "type": "string", "minLength": 1 },
              "capturedAt": { "type": "string", "format": "date-time" },
              "freshUntil": { "type": "string", "format": "date-time" },
              "stationCount": { "type": "integer", "minimum": 1 },
              "edgeCount": { "type": "integer", "minimum": 1 },
              "excludedTransferCount": { "type": "integer", "minimum": 0 },
              "depotExcludedCount": { "type": "integer", "minimum": 0 },
              "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "routeMapAdmissionEvidence": {
            "type": "object",
            "description": "공식 노선도 좌표 snapshot의 production materialization 승인 근거다. 사이버스테이션 HTML/CSS(부산)와 FILE 위경도(서울) 두 형태를 공통 필드로 수용한다.",
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": ["topologySourceId"],
                  "properties": {
                    "topologySourceId": { "const": "capital-route-topology" }
                  }
                },
                "then": { "required": ["currentTopologyAdmission"] }
              }
            ],
            "required": [
              "issue",
              "materializer",
              "verificationTest",
              "snapshotId",
              "snapshotPath",
              "snapshotSha256",
              "capturedAt",
              "freshUntil",
              "stationCount",
              "rawSha256",
              "positionsSha256"
            ],
            "properties": {
              "issue": { "type": "integer", "minimum": 1 },
              "admissionKind": {
                "type": "string",
                "enum": ["official-file-latlon"],
                "description": "FILE 위경도 admission일 때 설정한다. 사이버스테이션 HTML/CSS admission은 생략한다."
              },
              "materializer": { "type": "string", "minLength": 1 },
              "verificationTest": { "type": "string", "minLength": 1 },
              "snapshotId": { "type": "string", "minLength": 1 },
              "snapshotPath": { "type": "string", "minLength": 1 },
              "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "capturedAt": { "type": "string", "format": "date-time" },
              "freshUntil": { "type": "string", "format": "date-time" },
              "stationCount": { "type": "integer", "minimum": 1 },
              "rawStationCount": { "type": "integer", "minimum": 0 },
              "quarantinedCount": { "type": "integer", "minimum": 0 },
              "exitRowCount": { "type": "integer", "minimum": 0 },
              "datasetId": { "type": "string", "minLength": 1 },
              "datasetIds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "htmlSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "cssSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "connectorEvidencePath": { "type": "string", "minLength": 1 },
              "connectorEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "connectorAssetSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "rawSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "positionsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "lineIds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "lineStationCounts": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 1 }
              },
              "observedDataUpdatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "connectorsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "connectorCount": { "type": "integer", "minimum": 1 },
              "connectorAssetCount": { "type": "integer", "minimum": 1 },
              "topologySourceId": { "type": "string", "minLength": 1 },
              "topologySnapshotId": { "type": "string", "minLength": 1 },
              "topologyContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "topologyLineages": {
                "type": "array",
                "description": "다중 topology snapshot lineage(노선별). 단일 topology* 필드와 함께 사용하며 Busan 단일 lineage 호환을 유지한다.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sourceId", "snapshotId", "contentSha256"],
                  "properties": {
                    "sourceId": { "type": "string", "minLength": 1 },
                    "snapshotId": { "type": "string", "minLength": 1 },
                    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "lineId": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "freshnessExtension": {
                "type": "object",
                "description": "동일 source/snapshot을 reviewed positive observation으로 재검증한 closed freshness extension receipt다.",
                "additionalProperties": false,
                "required": [
                  "schemaVersion",
                  "artifactKind",
                  "decision",
                  "reasonCode",
                  "sourceId",
                  "snapshotId",
                  "snapshotSha256",
                  "rawEvidenceSha256",
                  "sourceClassId",
                  "policySha256",
                  "observationEvidenceSha256",
                  "currentFreshUntil",
                  "extendedFreshUntil",
                  "evaluatedAt",
                  "observedAt",
                  "resultSha256"
                ],
                "properties": {
                  "schemaVersion": { "const": 1 },
                  "artifactKind": { "const": "source-freshness-extension-result" },
                  "decision": { "const": "EXTENDED" },
                  "reasonCode": { "const": "POSITIVE_OBSERVATION_EXTENDED" },
                  "sourceId": { "type": "string", "minLength": 1 },
                  "snapshotId": { "type": "string", "minLength": 1 },
                  "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "rawEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "sourceClassId": { "type": "string", "minLength": 1 },
                  "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "observationEvidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "currentFreshUntil": { "type": "string", "format": "date-time" },
                  "extendedFreshUntil": { "type": "string", "format": "date-time" },
                  "evaluatedAt": { "type": "string", "format": "date-time" },
                  "observedAt": { "type": "string", "format": "date-time" },
                  "resultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              },
              "currentTopologyAdmission": {
                "type": "object",
                "description": "historical route-map position snapshot을 current capital topology에 다시 결속한 admission이다.",
                "additionalProperties": false,
                "required": [
                  "schemaVersion",
                  "artifactKind",
                  "issue",
                  "status",
                  "topologySnapshotId",
                  "topologyContentSha256",
                  "positionSnapshotSha256",
                  "reviewedAt",
                  "freshUntil",
                  "topologyLineages"
                ],
                "properties": {
                  "schemaVersion": { "const": 1 },
                  "artifactKind": { "const": "capital-route-map-current-topology-admission" },
                  "issue": { "type": "integer", "minimum": 1 },
                  "status": { "const": "ADMITTED" },
                  "topologySnapshotId": { "type": "string", "pattern": "^capital-route-topology-[0-9]{8}$" },
                  "topologyContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "positionSnapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "reviewedAt": { "type": "string", "format": "date-time" },
