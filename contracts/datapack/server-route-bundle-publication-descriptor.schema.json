{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server route bundle publication descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "producer",
    "manifest",
    "sourceSnapshotSetHash",
    "publicationReceipt",
    "release",
    "descriptorSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "artifactKind": { "const": "server-route-bundle-publication-descriptor" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "gitSha"],
      "properties": {
        "repository": { "const": "AquilaXk/easysubway-data" },
        "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "manifest": {
      "allOf": [
        { "$ref": "artifact-component-manifest.schema.json" },
        {
          "type": "object",
          "required": ["artifactKind"],
          "properties": { "artifactKind": { "const": "server-route-bundle" } }
        }
      ]
    },
    "sourceSnapshotSetHash": { "$ref": "#/$defs/sha256" },
    "publicationReceipt": { "$ref": "server-route-bundle-publication-receipt.schema.json" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "finalSha256",
        "finalRawSha256",
        "publicationReceiptSha256",
        "publicationReceiptRawSha256",
        "promotionEvidenceSha256"
      ],
      "properties": {
        "result": { "const": "GO" },
        "finalSha256": { "$ref": "#/$defs/sha256" },
        "finalRawSha256": { "$ref": "#/$defs/sha256" },
        "publicationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "publicationReceiptRawSha256": { "$ref": "#/$defs/sha256" },
        "promotionEvidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "descriptorSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
