{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server route bundle publication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "repository", "candidate", "locator", "objects", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "server-route-bundle-publication-receipt" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gitSha"],
      "properties": {
        "name": { "const": "AquilaXk/easysubway-data" },
        "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId", "releaseSequence", "stationSetSha256", "sourceSnapshotSetHash", "signingInputSha256",
        "signedManifestRawSha256", "payloadRootSha256", "componentInventorySha256", "componentDigests",
        "activeFrom", "freshUntil", "keyId", "prePublicationFinalSha256"
      ],
      "properties": {
        "bundleId": { "$ref": "#/$defs/rawString" },
        "releaseSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stationSetSha256": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotSetHash": { "$ref": "#/$defs/sha256" },
        "signingInputSha256": { "$ref": "#/$defs/sha256" },
        "signedManifestRawSha256": { "$ref": "#/$defs/sha256" },
        "payloadRootSha256": { "$ref": "#/$defs/sha256" },
        "componentInventorySha256": { "$ref": "#/$defs/sha256" },
        "componentDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessibility", "fare", "timetable", "topology"],
          "properties": {
            "accessibility": { "$ref": "#/$defs/sha256" },
            "fare": { "$ref": "#/$defs/sha256" },
            "timetable": { "$ref": "#/$defs/sha256" },
            "topology": { "$ref": "#/$defs/sha256" }
          }
        },
        "activeFrom": { "$ref": "#/$defs/kstMillisecondInstant" },
        "freshUntil": { "$ref": "#/$defs/kstMillisecondInstant" },
        "keyId": { "$ref": "#/$defs/rawString" },
        "prePublicationFinalSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicBaseUrl", "objectPrefix"],
      "properties": {
        "publicBaseUrl": {
          "type": "string",
          "pattern": "^https://objectstorage\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.oraclecloud\\.com/n/[A-Za-z0-9_~-](?:[A-Za-z0-9._~-]*[A-Za-z0-9_~-])?/b/[A-Za-z0-9_~-](?:[A-Za-z0-9._~-]*[A-Za-z0-9_~-])?/o$"
        },
        "objectPrefix": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/$" }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "compatibility.json" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/compatibility\\.json$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "manifest.json" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/manifest\\.json$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "manifest.signing-input.json" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/manifest\\.signing-input\\.json$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "payload/accessibility.sqlite.zst" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/payload/accessibility\\.sqlite\\.zst$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "payload/fare.sqlite.zst" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/payload/fare\\.sqlite\\.zst$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "payload/timetable.sqlite.zst" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/payload/timetable\\.sqlite\\.zst$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "payload/topology.sqlite.zst" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/payload/topology\\.sqlite\\.zst$" }
          }
        },
        {
          "$ref": "#/$defs/receiptObject",
          "properties": {
            "path": { "const": "provenance.json" },
            "objectKey": { "type": "string", "pattern": "^server-route-bundles/v1/[a-f0-9]{64}/provenance\\.json$" }
          }
        }
      ],
      "items": false
    },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "receiptObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "objectKey", "sizeBytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "objectKey": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawString": { "type": "string", "pattern": "^(?!\\s)[\\s\\S]*\\S$" },
    "kstMillisecondInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+09:00$"
    }
  }
}
