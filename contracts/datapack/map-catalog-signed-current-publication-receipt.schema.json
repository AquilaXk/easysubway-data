{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map and station catalog signed-current publication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "producerGitSha", "releaseSequence", "signedFinalDescriptorSha256", "stationSetSha256", "freshUntil", "mapPack", "stationCatalogPack", "receiptSha256", "keyId", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "map-catalog-signed-current-publication-receipt" },
    "producerGitSha": { "$ref": "#/$defs/gitSha" },
    "releaseSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "signedFinalDescriptorSha256": { "$ref": "#/$defs/sha256" },
    "stationSetSha256": { "$ref": "#/$defs/sha256" },
    "freshUntil": { "type": "string", "format": "date-time" },
    "mapPack": { "$ref": "#/$defs/mapPack" },
    "stationCatalogPack": { "$ref": "#/$defs/catalogPack" },
    "receiptSha256": { "$ref": "#/$defs/sha256" },
    "keyId": { "type": "string", "minLength": 1 },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "object": { "type": "object", "additionalProperties": false, "required": ["path", "sizeBytes", "sha256"], "properties": { "path": { "type": "string", "pattern": "^(manifest\\.json|payload/(metropolitan\\.svg|stations-layout\\.json|line-styles\\.json|interchange-layout\\.json|catalog\\.sqlite))$" }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "mapPack": { "type": "object", "additionalProperties": false, "required": ["manifest", "objects"], "properties": { "manifest": { "type": "object" }, "objects": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/object" } } } },
    "catalogPack": { "type": "object", "additionalProperties": false, "required": ["manifest", "objects"], "properties": { "manifest": { "type": "object" }, "objects": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/object" } } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "rsa-sha256-map-catalog-signed-current-v1" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } } }
  }
}
