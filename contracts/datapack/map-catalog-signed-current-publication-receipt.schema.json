{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map and station catalog signed-current publication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactKind", "producerGitSha", "releaseSequence", "signedFinalDescriptorSha256", "stationSetSha256", "freshUntil", "mapPack", "stationCatalogPack", "receiptSha256", "keyId", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "map-catalog-signed-current-publication-receipt" },
    "producerGitSha": { "$ref": "#/$defs/gitSha" },
    "releaseSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "signedFinalDescriptorSha256": { "$ref": "#/$defs/sha256" },
    "stationSetSha256": { "$ref": "#/$defs/sha256" },
    "freshUntil": { "type": "string", "format": "date-time" },
    "mapPack": { "$ref": "#/$defs/mapPack" },
    "stationCatalogPack": { "$ref": "#/$defs/catalogPack" },
    "receiptSha256": { "$ref": "#/$defs/sha256" },
    "keyId": { "type": "string", "minLength": 1 },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "object": { "type": "object", "additionalProperties": false, "required": ["path", "sizeBytes", "sha256"], "properties": { "path": { "type": "string" }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "mapManifest": { "type": "object", "additionalProperties": false, "required": ["manifestVersion", "artifactKind", "mapPackId", "stationSetSha256", "payloadSha256"], "properties": { "manifestVersion": { "const": 1 }, "artifactKind": { "const": "map-pack" }, "mapPackId": { "type": "string", "minLength": 1 }, "stationSetSha256": { "$ref": "#/$defs/sha256" }, "payloadSha256": { "$ref": "#/$defs/sha256" } } },
    "catalogManifest": { "type": "object", "additionalProperties": false, "required": ["manifestVersion", "artifactKind", "catalogPackId", "stationSetSha256", "payloadSha256"], "properties": { "manifestVersion": { "const": 1 }, "artifactKind": { "const": "station-catalog-pack" }, "catalogPackId": { "type": "string", "minLength": 1 }, "stationSetSha256": { "$ref": "#/$defs/sha256" }, "payloadSha256": { "$ref": "#/$defs/sha256" } } },
    "mapManifestObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "manifest.json" } } }] },
    "mapInterchangeObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "payload/interchange-layout.json" } } }] },
    "mapStylesObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "payload/line-styles.json" } } }] },
    "mapSvgObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "payload/metropolitan.svg" } } }] },
    "mapStationsObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "payload/stations-layout.json" } } }] },
    "catalogManifestObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "manifest.json" } } }] },
    "catalogSqliteObject": { "allOf": [{ "$ref": "#/$defs/object" }, { "properties": { "path": { "const": "payload/catalog.sqlite" } } }] },
    "mapPack": { "type": "object", "additionalProperties": false, "required": ["manifest", "objects"], "properties": { "manifest": { "$ref": "#/$defs/mapManifest" }, "objects": { "type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{ "$ref": "#/$defs/mapManifestObject" }, { "$ref": "#/$defs/mapInterchangeObject" }, { "$ref": "#/$defs/mapStylesObject" }, { "$ref": "#/$defs/mapSvgObject" }, { "$ref": "#/$defs/mapStationsObject" }], "items": false } } },
    "catalogPack": { "type": "object", "additionalProperties": false, "required": ["manifest", "objects"], "properties": { "manifest": { "$ref": "#/$defs/catalogManifest" }, "objects": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "$ref": "#/$defs/catalogManifestObject" }, { "$ref": "#/$defs/catalogSqliteObject" }], "items": false } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": { "algorithm": { "const": "rsa-sha256-map-catalog-signed-current-v1" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } } }
  }
}
