{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact component manifest",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "artifactKind", "mapPackId", "stationSetSha256", "payloadSha256"],
      "properties": {
        "manifestVersion": { "const": 1 },
        "artifactKind": { "const": "map-pack" },
        "mapPackId": { "$ref": "#/$defs/rawString" },
        "stationSetSha256": { "$ref": "#/$defs/sha256" },
        "payloadSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "artifactKind", "catalogPackId", "stationSetSha256", "payloadSha256"],
      "properties": {
        "manifestVersion": { "const": 1 },
        "artifactKind": { "const": "station-catalog-pack" },
        "catalogPackId": { "$ref": "#/$defs/rawString" },
        "stationSetSha256": { "$ref": "#/$defs/sha256" },
        "payloadSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "artifactKind", "bundleId", "releaseSequence", "stationSetSha256", "payloadSha256", "topologySha256", "timetableSha256", "accessibilitySha256", "fareSha256", "provenanceSha256", "compatibilitySha256", "serviceTimezone", "activeFrom", "freshUntil", "schemaCompatibility", "keyId", "signature"],
      "properties": {
        "manifestVersion": { "const": 1 },
        "artifactKind": { "const": "server-route-bundle" },
        "bundleId": { "$ref": "#/$defs/rawString" },
        "releaseSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stationSetSha256": { "$ref": "#/$defs/sha256" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "topologySha256": { "$ref": "#/$defs/sha256" },
        "timetableSha256": { "$ref": "#/$defs/sha256" },
        "accessibilitySha256": { "$ref": "#/$defs/sha256" },
        "fareSha256": { "$ref": "#/$defs/sha256" },
        "provenanceSha256": { "$ref": "#/$defs/sha256" },
        "compatibilitySha256": { "$ref": "#/$defs/sha256" },
        "serviceTimezone": { "const": "Asia/Seoul" },
        "activeFrom": { "$ref": "#/$defs/kstMillisecondInstant" },
        "freshUntil": { "$ref": "#/$defs/kstMillisecondInstant" },
        "schemaCompatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backendMin", "backendMax"],
          "properties": {
            "backendMin": { "const": 3 },
            "backendMax": { "const": 3 }
          }
        },
        "keyId": { "$ref": "#/$defs/rawString" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "rsa-sha256-server-route-bundle-v1" },
            "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])" }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "rawString": { "type": "string", "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])" },
    "kstMillisecondInstant": {
      "description": "Gregorian calendar KST millisecond instant; February 29 is accepted only in years divisible by 4, except centuries unless divisible by 400.",
      "type": "string",
      "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:00|0[48]|[2468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}\\+09:00(?![\\s\\S])"
    }
  }
}
