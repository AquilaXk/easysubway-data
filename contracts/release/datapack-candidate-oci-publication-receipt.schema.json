{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data pack candidate OCI publication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "contractVersion",
    "repository",
    "workflowRunId",
    "headSha",
    "candidateId",
    "artifactName",
    "descriptor",
    "objects",
    "locator",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "datapack-candidate-oci-publication-receipt" },
    "contractVersion": { "const": "datapack-candidate-publication-receipt-v1" },
    "repository": { "const": "AquilaXk/easysubway-data" },
    "workflowRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "artifactName": { "type": "string", "pattern": "^easysubway-datapack-candidate-[1-9][0-9]*$" },
    "descriptor": { "$ref": "#/$defs/descriptorReceiptObject" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/payloadReceiptObject" }
    },
    "locator": { "type": "string", "pattern": "^oci://" },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["etag", "versionId", "observedAt"],
      "properties": {
        "etag": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "descriptorReceiptObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "objectKey", "ociUri", "sizeBytes", "sha256", "put", "get"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/sha256" },
        "objectKey": { "type": "string", "minLength": 1 },
        "ociUri": { "type": "string", "pattern": "^oci://" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "put": { "$ref": "#/$defs/observation" },
        "get": { "$ref": "#/$defs/observation" }
      }
    },
    "payloadReceiptObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "objectKey", "ociUri", "sizeBytes", "sha256", "put", "get"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "objectKey": { "type": "string", "minLength": 1 },
        "ociUri": { "type": "string", "pattern": "^oci://" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "put": { "$ref": "#/$defs/observation" },
        "get": { "$ref": "#/$defs/observation" }
      }
    }
  }
}
