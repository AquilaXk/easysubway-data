{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "easysubway/contracts/release/datapack-candidate-tuple",
  "title": "Data candidate creation handoff tuple",
  "type": "object",
  "required": ["candidateBinding", "freshnessExpiresAt"],
  "additionalProperties": false,
  "properties": {
    "candidateBinding": {
      "type": "object",
      "required": ["candidateId", "buildSpecSha256", "manifestSha256"],
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "buildSpecSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "freshnessExpiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
